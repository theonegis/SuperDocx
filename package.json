{
  "name": "superdocx-desktop",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && node tests/smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "test:browser": "node tests/browser-smoke.mjs",
    "icons": "node scripts/build-icons.mjs",
    "test:features": "npm run build && node tests/features.mjs && node tests/rich-editing.mjs",
    "test:references": "node tests/citations.mjs && node tests/references-ui.mjs"
  },
  "build": {
    "appId": "dev.superdocx.desktop",
    "productName": "SuperDocx",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office"
    }
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "superdoc": "2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "jszip": "3.10.1",
    "vite": "8.2.2"
  },
  "description": "Local Electron and React DOCX integration prototype powered by SuperDoc"
}
